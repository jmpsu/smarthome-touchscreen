# =============================================================================
# SmartHome Touchscreen — configuration
# -----------------------------------------------------------------------------
# The setup wizard (setup/first_run_setup.py) writes a real ".env" from this
# template based on what you type on the touch screen. You normally do NOT edit
# this file by hand. Copy it to ".env" only if you want to pre-seed values
# before running install.sh.
#
# NEVER commit a real ".env" — it is git-ignored. All values below are
# placeholders.
# =============================================================================

# --- General ----------------------------------------------------------------
# Location + timezone drive the clock and the tide/weather displays.
TIMEZONE=America/New_York
LATITUDE=27.0648
LONGITUDE=-80.1387
ELEVATION=3

# --- Home Assistant ----------------------------------------------------------
# A long-lived access token is generated automatically by the wizard after HA
# first boots. Leave blank; the wizard fills it in.
HA_BASE_URL=http://homeassistant:8123
HA_TOKEN=

# HomeKit bridge PIN shown as a QR code in the dashboard Settings screen.
# Format must be XXX-XX-XXX. Generated by the wizard if left as the default.
HOMEKIT_PIN=031-45-154

# --- Tuya / SmartLife (lights + sprinkler) -----------------------------------
# Uses the QR-code "Smart Life" sign-in (tuya/tuya-smart-life) — no developer
# account. The wizard walks you through scanning the QR with the SmartLife app.
# These are populated automatically after the QR sign-in succeeds.
TUYA_USER_CODE=
TUYA_ENDPOINT=https://openapi.tuyaus.com

# --- WiZ ---------------------------------------------------------------------
# WiZ bulbs are auto-discovered over UDP on the LAN. No credentials needed.
WIZ_AUTODISCOVER=true

# --- Eufy Security cameras ---------------------------------------------------
# Needed so eufy-security-ws can pull the two camera streams for live view.
EUFY_USERNAME=your-eufy-account@example.com
EUFY_PASSWORD=
# Optional 2FA / verification region.
EUFY_COUNTRY=US

# --- Marvelight / Monster / generic light strips -----------------------------
# Many of these are Tuya/BLE-based and come in via the Tuya/SmartLife account
# above. If a strip exposes a local API, add its host here (comma-separated).
EXTRA_LIGHT_HOSTS=

# --- Dashboard ---------------------------------------------------------------
DASHBOARD_PORT=8080
# Screen geometry — the monitor is a 1920x720 ultrawide.
SCREEN_WIDTH=1920
SCREEN_HEIGHT=720

# --- Rotating info displays --------------------------------------------------
X_ACCOUNT=SurfnWeatherman
TIDES_WEEK_URL=https://www.tidespro.com/us/florida/hobe-sound-jupiter-island
TIDES_MONTH_URL=https://www.tidespro.com/us/florida/jupiter-inlet-us-highway-1-bridge/month
ROTATE_SECONDS=10
