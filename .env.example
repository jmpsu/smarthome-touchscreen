# =============================================================================
# SmartHome Touchscreen — runtime configuration
# -----------------------------------------------------------------------------
# Copy to .env for a local run. On the VPS this same content lives at
# /etc/smarthome-panel.env and is written by the deploy workflow from the
# repository secrets — do not edit it there by hand, it is overwritten on
# every deploy.
#
# Every key below is one the code actually reads. Blank means "use the default"
# or "hide that panel".
# =============================================================================

# ---- Home Assistant ---------------------------------------------------------
# NOTE: the variable is HA_BASE_URL, not HA_URL. ha_client.py reads only this
# name; anything else silently falls back to http://homeassistant:8123.
HA_BASE_URL=https://ha.example.com
HA_TOKEN=

# Serve a representative fake fleet instead of talking to Home Assistant.
# Useful for working on the UI without credentials. true/false.
DEMO_MODE=false

# ---- Location ---------------------------------------------------------------
# Drives weather (Open-Meteo) and the celestial event calculations.
LATITUDE=27.0586
LONGITUDE=-80.1581
TIMEZONE=America/New_York

# ---- Rotating info displays -------------------------------------------------
# X/Twitter handle without the @. Blank hides the social panel.
X_ACCOUNT=

# Tide data is scraped from tidespro.com. Both panels stay hidden unless
# TIDES_WEEK_URL is set; TIDES_MONTH_URL powers the tap-through month view.
TIDES_WEEK_URL=
TIDES_MONTH_URL=

# ---- Display ----------------------------------------------------------------
SCREEN_WIDTH=1920
SCREEN_HEIGHT=720
ROTATE_SECONDS=10

# ---- HomeKit / Siri ---------------------------------------------------------
# Shown on the setup screen so you can pair the HomeKit bridge. Generated by
# Home Assistant when the bridge is first enabled.
HOMEKIT_PIN=

# -----------------------------------------------------------------------------
# Not needed here:
#   Spotify  — reaches the panel as a media_player entity through the Home
#              Assistant Spotify integration, so there is no client ID/secret
#              to configure in this file.
#   Weather  — Open-Meteo needs no API key.
# -----------------------------------------------------------------------------
