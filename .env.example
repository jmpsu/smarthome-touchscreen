# Home Assistant Configuration
HA_URL=http://homeassistant:8123
HA_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudflare Workers Base URL
CLOUDFLARE_WORKERS_URL=https://workers.joeysvault.com

# Claude API (for voice command fallback - OPTIONAL)
# If omitted, only local regex parsing is used (zero cost)
CLAUDE_API_KEY=sk-ant-v1-...

# Location (for weather, celestial, tides)
LATITUDE=40.7128
LONGITUDE=-74.0060
TIMEZONE=America/New_York

# NOAA Tides Station ID (free API, no key needed)
TIDES_STATION=8454000

# Twitter API (optional: if omitted, mock data used)
TWITTER_API_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAA...

# Spotify API (optional: for now-playing)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=https://panel.joeysvault.app/auth/spotify/callback

# Display
DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=720
ROTATE_SECONDS=10

# HomeKit
HOMEKIT_PIN=123-45-678
