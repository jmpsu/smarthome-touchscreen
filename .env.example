# =============================================================================
# SmartHome Touchscreen — configuration
# -----------------------------------------------------------------------------
# This project is generic and shareable: NOTHING here is tied to a specific
# home. The setup wizard (setup/first_run_setup.py) writes a real ".env" from
# this template based on what each user enters on the touch screen, and the
# dashboard's Settings screen can edit it later. You normally do NOT edit this
# file by hand.
#
# NEVER commit a real ".env" — it is git-ignored. All values below are neutral
# placeholders/defaults.
# =============================================================================

# --- General ----------------------------------------------------------------
# Location + timezone drive the clock and (optional) tide/weather displays.
# Left blank by default; the wizard asks for them (or auto-detects timezone).
TIMEZONE=
LATITUDE=
LONGITUDE=
ELEVATION=0

# --- Home Assistant ----------------------------------------------------------
# A long-lived access token is generated automatically after HA first boots.
HA_BASE_URL=http://homeassistant:8123
HA_TOKEN=

# HomeKit bridge PIN shown as a QR/code on the dashboard Settings screen.
# Generated per-install by the wizard (format XXX-XX-XXX). Leave blank.
HOMEKIT_PIN=

# --- Tuya / SmartLife (lights + any SmartLife device) ------------------------
# QR-code "Smart Life" sign-in (tuya/tuya-smart-life) — no developer account.
# The wizard walks you through the one QR scan. Filled in after sign-in.
TUYA_ENABLED=false
TUYA_USER_CODE=

# --- WiZ ---------------------------------------------------------------------
# WiZ bulbs are auto-discovered over the LAN. No credentials needed.
WIZ_AUTODISCOVER=true

# --- Eufy Security cameras (optional) ----------------------------------------
# Only needed if you have Eufy cameras and want live views on the panel.
EUFY_ENABLED=false
EUFY_USERNAME=
EUFY_PASSWORD=
EUFY_COUNTRY=US

# --- Extra light strips (any brand with a local API) -------------------------
# Most strips link through the SmartLife/Tuya account above. If a strip has a
# fixed IP with a local API, list it here (comma-separated). Optional.
EXTRA_LIGHT_HOSTS=

# --- Dashboard ---------------------------------------------------------------
DASHBOARD_PORT=8080
# Screen geometry — override if your panel differs. Defaults suit the common
# 1920x720 ultrawide, but any resolution works.
SCREEN_WIDTH=1920
SCREEN_HEIGHT=720

# --- Rotating info displays (all optional) -----------------------------------
# These personalize the rotating home panel. Leave blank to hide that panel;
# the clock/weather panel always shows. Users set these in the wizard/Settings.
#
#   X_ACCOUNT       an X/Twitter handle (without @) to show a live feed
#   TIDES_WEEK_URL  a tidespro.com location page (adds tide/solunar panels)
#   TIDES_MONTH_URL the matching tidespro "/month" page for the drill-down
X_ACCOUNT=
TIDES_WEEK_URL=
TIDES_MONTH_URL=
ROTATE_SECONDS=10
