# =============================================================================
#  SMARTHOME TOUCHSCREEN — CREDENTIALS FILE  (fill this out, save, hand back)
# -----------------------------------------------------------------------------
#  This is the ONLY file you need to fill in. Save it as ".env" on the VPS (or
#  hand it back and I'll drop it in). Everything else is already wired.
#
#  Legend:
#    [REQUIRED]  needed for that feature to work at all
#    [OPTIONAL]  feature is skipped/hidden if left blank
#    [CLOUD]     works from the Contabo VPS with no home-network access
#    [LOCAL]     device is LOCAL-ONLY — the VPS must reach your home LAN to use
#                it (see TAILSCALE section + docs/DEPLOY-VPS.md). Leave blank if
#                you don't want to set up the tunnel yet.
#
#  Use throwaway / sandbox accounts first if you like; swap in real ones later
#  by editing this file and restarting the stack. Nothing here is committed to
#  git (.env is git-ignored).
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
#  0.  WHERE THIS RUNS  (Contabo VPS)
# ─────────────────────────────────────────────────────────────────────────────
# Public hostname or IP of your Contabo VPS (used for links + optional TLS).
VPS_HOST=                      # [REQUIRED] e.g. 194.163.x.x  or  home.example.com
# A domain you point at the VPS if you want HTTPS (optional; IP works for test).
VPS_DOMAIN=                    # [OPTIONAL] e.g. home.example.com
# Timezone + location (drives clock, tides, sun/moon, and celestial events).
TIMEZONE=America/New_York      # [REQUIRED] IANA name
LATITUDE=                      # [REQUIRED for weather/tides/celestial] e.g. 27.06
LONGITUDE=                     # [REQUIRED for weather/tides/celestial] e.g. -80.14


# ─────────────────────────────────────────────────────────────────────────────
#  1.  TAILSCALE  — the bridge that lets the VPS reach your home LOCAL devices
# ─────────────────────────────────────────────────────────────────────────────
# WiZ bulbs, BLE light strips, and camera RTSP are LOCAL-ONLY. For the VPS to
# control them, a Tailscale "subnet router" runs at home (on the Pi) and shares
# your home subnet with the VPS. Get an auth key at:
#   https://login.tailscale.com/admin/settings/keys   (reusable, tagged)
TAILSCALE_AUTHKEY=             # [OPTIONAL/LOCAL] tskey-auth-...
# Your home LAN subnet the Pi will advertise (so the VPS can route to it).
HOME_SUBNET=                   # [OPTIONAL/LOCAL] e.g. 192.168.1.0/24
# If you skip Tailscale for now, CLOUD integrations below still work.


# ─────────────────────────────────────────────────────────────────────────────
#  2.  TUYA / SMART LIFE  — most of your lights, strips, and the sprinkler
# ─────────────────────────────────────────────────────────────────────────────
# For VPS/remote control, the Tuya *Cloud* developer project is the reliable
# path (works without being on your LAN). Create a free project at
#   https://iot.tuya.com  →  Cloud → Development → Create Cloud Project
# then link your Smart Life app account (Devices → Link App Account → scan QR).
TUYA_ENABLED=true              # [REQUIRED to use Tuya] true/false
TUYA_ACCESS_ID=                # [REQUIRED-CLOUD] "Access ID / Client ID"
TUYA_ACCESS_SECRET=            # [REQUIRED-CLOUD] "Access Secret / Client Secret"
TUYA_REGION=us                 # [REQUIRED-CLOUD] us | eu | cn | in
TUYA_APP_ACCOUNT_COUNTRY=1     # [REQUIRED-CLOUD] country calling code, US = 1
TUYA_APP_ACCOUNT=              # [REQUIRED-CLOUD] the email/phone on your SmartLife app
# --- OR, the no-dev-account path (uses the Smart Life QR at first boot): ------
TUYA_USER_CODE=                # [OPTIONAL] SmartLife > Me > Settings > Account > "User Code"


# ─────────────────────────────────────────────────────────────────────────────
#  3.  WiZ  — Wi-Fi bulbs (LOCAL ONLY)
# ─────────────────────────────────────────────────────────────────────────────
# No login needed. Auto-discovered over the LAN — but LOCAL-ONLY, so from the
# VPS it requires the Tailscale subnet route above. If you list fixed IPs here
# they're used directly (helps across the tunnel).
WIZ_ENABLED=true               # [OPTIONAL] true/false
WIZ_BULB_IPS=                  # [OPTIONAL/LOCAL] comma-separated, e.g. 192.168.1.31,192.168.1.32


# ─────────────────────────────────────────────────────────────────────────────
#  4.  EUFY SECURITY  — cameras (CLOUD login, streams may be LOCAL)
# ─────────────────────────────────────────────────────────────────────────────
# Login is cloud-based (works from VPS). Live RTSP streams are often local, so
# smooth video may need the Tailscale route; snapshots work via cloud.
# TIP: make a SECONDARY Eufy account and *share* the cameras to it, so 2FA on
# your main phone account doesn't fight with the server login.
EUFY_ENABLED=true              # [OPTIONAL] true/false
EUFY_USERNAME=                 # [REQUIRED if enabled] account email
EUFY_PASSWORD=                 # [REQUIRED if enabled]
EUFY_COUNTRY=US                # [REQUIRED if enabled] 2-letter country


# ─────────────────────────────────────────────────────────────────────────────
#  5.  SPOTIFY  — now-playing + playback control on the panel
# ─────────────────────────────────────────────────────────────────────────────
# Needs Spotify Premium + a free Spotify "app" for OAuth. Create one at
#   https://developer.spotify.com/dashboard  → Create app
# Redirect URI to add in that app (use your VPS host):
#   https://<VPS_DOMAIN or VPS_HOST>:8123/auth/external/callback
SPOTIFY_ENABLED=true           # [OPTIONAL] true/false
SPOTIFY_CLIENT_ID=             # [REQUIRED if enabled]
SPOTIFY_CLIENT_SECRET=         # [REQUIRED if enabled]
# (The account itself is linked by an OAuth click in Home Assistant on first run
#  — no password stored here. I'll walk you through that one click.)


# ─────────────────────────────────────────────────────────────────────────────
#  6.  MARVELIGHT / MONSTER / OTHER STRIPS
# ─────────────────────────────────────────────────────────────────────────────
# If these are paired inside the Smart Life app, they arrive via TUYA above —
# nothing to add. If a strip is BLE-only (Marvelight often is), it's LOCAL and
# needs a Bluetooth adapter on the machine on the LAN (the Pi), not the VPS.
# If a strip has a fixed-IP local API, list it here:
EXTRA_LIGHT_HOSTS=             # [OPTIONAL/LOCAL] comma-separated IPs


# ─────────────────────────────────────────────────────────────────────────────
#  7.  INFO PANELS  (all optional — personalize the rotating displays)
# ─────────────────────────────────────────────────────────────────────────────
X_ACCOUNT=                     # [OPTIONAL] X/Twitter handle w/o @, e.g. SurfnWeatherman
TIDES_WEEK_URL=                # [OPTIONAL] a tidespro.com location page
TIDES_MONTH_URL=               # [OPTIONAL] the matching tidespro "/month" page
ROTATE_SECONDS=10


# ─────────────────────────────────────────────────────────────────────────────
#  8.  AUTO-GENERATED  (leave blank — the installer fills these)
# ─────────────────────────────────────────────────────────────────────────────
HA_BASE_URL=http://homeassistant:8123
HA_TOKEN=                      # generated after HA first boot
HOMEKIT_PIN=                   # generated per-install
DASHBOARD_PORT=8080
SCREEN_WIDTH=1920
SCREEN_HEIGHT=720
